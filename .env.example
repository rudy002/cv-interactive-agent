# Copy to .env.local and fill in. Never commit .env.local.

# n8n webhook that fronts the AI agent (Webhook -> Simple Memory -> AI Agent ->
# Respond to Webhook). The server proxies to it, so this value never reaches the
# browser — keep it out of any NEXT_PUBLIC_* variable.
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/your-id

# Optional. If set, /api/knowledge requires this token (Authorization: Bearer <token>
# or x-knowledge-token: <token>). Leave unset to keep the endpoint public — the
# content is the CV, which the pages already display.
# KNOWLEDGE_API_TOKEN=
